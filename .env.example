# ══ DAMTAT ═══════════════════════════════════════════════
# Бұл файл GitHub-қа ЖІБЕРІЛМЕЙДІ (.gitignore). Vercel → Settings → Environment Variables-ке көшір.

# ── Supabase (ЖАҢА жоба: Dashboard → Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ Тек серверде. Ешқашан NEXT_PUBLIC_ қоспа!
SUPABASE_SERVICE_ROLE_KEY=

# ── Кафеде (QR) тапсырыс → Telegram жабық канал ──────────
# @BotFather → /newbot → token. Ботты жабық каналға ӘКІМШІ етіп қос.
TELEGRAM_BOT_TOKEN=
# Каналдың ID-і (-100... деп басталады)
TELEGRAM_CHAT_ID=

# ── Онлайн тапсырыс → WhatsApp ───────────────────────────
# Кафенің WhatsApp нөмірі, мысалы: 77011234567
WHATSAPP_NUMBER=

# ── Админ панель (/admin) ────────────────────────────────
# Пароль кемінде 12 таңба, әйтпесе панель ашылмайды
ADMIN_USER=damtat
ADMIN_PASSWORD=
# Кассир: тек тапсырыстар + «Бар/Бітті» (баға өзгерте алмайды). Керек болмаса — бос қалдыр
CASHIER_USER=kassa
CASHIER_PASSWORD=

NEXT_PUBLIC_RESTAURANT_NAME=DAMTAT
